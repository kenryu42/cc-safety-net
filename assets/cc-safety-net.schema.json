{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/kenryu42/cc-safety-net/main/assets/cc-safety-net.schema.json",
  "title": "CC Safety Net Configuration",
  "description": "Configuration file for cc-safety-net rulebook sources and local policy",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema reference for IDE support"
    },
    "version": {
      "type": "number",
      "const": 1,
      "description": "Schema version (must be 1)"
    },
    "rules": {
      "default": [],
      "description": "Rulebook source strings such as project-rules or owner/repo#main/team-rules",
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overrides": {
      "default": {},
      "description": "Rule overrides by id",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[^/]+\\/[^/]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "const": "off"
          },
          {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Replacement block reason"
              },
              "intent": {
                "type": "string",
                "enum": [
                  "hard_stop",
                  "use_alternative",
                  "scope_down",
                  "manual_only",
                  "stop_and_explain"
                ]
              }
            },
            "required": ["reason"],
            "additionalProperties": {}
          }
        ],
        "description": "Disable a rule or replace its block reason and intent."
      }
    },
    "transparent_wrappers": {
      "default": [],
      "description": "Commands that transparently execute a visible protected child command",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
        "description": "Command name such as 'git', 'docker', or 'rtk'."
      },
      "uniqueItems": true
    },
    "command_tools": {
      "default": [],
      "description": "Tool names, beyond each integration's built-in shell tools, whose 'command' argument is analyzed as a shell command",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[^\\s\\p{Cc}]{1,256}$",
            "description": "Exact tool name such as 'ops_bash'. The working directory is read from 'workdir', 'cwd', or 'working_directory'."
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[^\\s\\p{Cc}]{1,256}$",
                "description": "Exact tool name."
              },
              "cwd": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[^\\s\\p{Cc}]{1,256}$",
                    "description": "Name of the argument that holds the working directory."
                  },
                  {
                    "const": false,
                    "description": "The tool has no working directory on this machine, such as one that runs commands on a remote host: no working-directory argument is read and commands are checked against the session directory."
                  }
                ]
              }
            },
            "required": ["name"]
          }
        ]
      }
    }
  },
  "required": ["version"],
  "additionalProperties": {}
}
