      "detected": false,
      "configured": false,
      "inspectionStatus": "not-applicable",
      "configPath": "<root>/home/.gemini/config/hooks.json"
    },
    {
      "platform": "codex",
      "detected": false,
      "configured": false,
      "inspectionStatus": "not-applicable"
    },
    {
