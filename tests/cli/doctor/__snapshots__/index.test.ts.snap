exports[`doctor --json a fresh home reports no configured integration and exits 1: fresh 1`] = `
"{
  "hooks": [
    {
      "platform": "claude-code",
      "detected": false,
      "configured": false,
      "inspectionStatus": "not-applicable"
    },
    {
      "platform": "amp",
      "detected": false,
      "configured": false,
      "inspectionStatus": "not-applicable"
    },
    {
