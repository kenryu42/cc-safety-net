{
  "description": "Block unsafe Codex tool calls with CC Safety Net.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/bin/cc-safety-net.js\" hook --codex"
          }
        ]
      }
    ]
  }
}
