{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "next",
    "outDir": "dist-next",
    "noEmit": false,
    "stripInternal": true
  },
  "include": ["next/**/*"],
  // The frontend is browser code with its own lib and globals; it ships inside
  // the page, not as a declaration. tsconfig.gui.json covers it.
  "exclude": ["tests", "dist", "dist-next", "node_modules", "next/gui/frontend"]
}
